{
  "name": "missile-punch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "editor": "vite --open /editor.html",
    "tuner": "vite --open /tuner.html",
    "harness": "vite --open /harness.html",
    "build": "tsc --noEmit && vite build",
    "demo": "tsc --noEmit && SINGLEFILE=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
